-- The mutant roster (Config/Mutants, generated by tools/gen-mutants.luau from Config/MutantStyle):
-- 500 generated species (83 per egg tier + 2 extra Commons) plus the limited eggs' hand-made ones;
-- feature budgets by rarity; nothing shared between tiers; unique names; Epic / Legendary props
-- unique within their tier; every species builds in Lune at size 1 and Titan with no big Neon.
local roblox = require("@lune/roblox")
local harness = require("../tools/harness")

return function(t)
	local Mutants = t.require("src/shared/Config/Mutants")
	local Style = t.require("src/shared/Config/MutantStyle")
	local Eggs = t.require("src/shared/Config/Eggs")
	local GameConfig = t.require("src/shared/Config/Game")

	local COUNTS = { Common = 26, Uncommon = 20, Rare = 16, Epic = 13, Legendary = 8 }
	local EXTRA = { Starter = 1, Swamp = 1 }
	local ORIGINALS = {
		"Blorp",
		"Snorkle",
		"Toothy Pip",
		"Triclops",
		"King Goober",
		"Muckling",
		"Bogwump",
		"Croakzilla",
		"Mire Hydra",
		"Swamp Sovereign",
		"Beaker Bean",
		"Gogglegunk",
		"Clonelet",
		"Brainiac Blob",
		"Dr. Splice",
		"Sludgeling",
		"Fumefang",
		"Rad Roach",
		"Glowgutter",
		"Toxic Titan",
		"Nullnub",
		"Echo Eye",
		"Shadewing",
		"Rift Gremlin",
		"The Hollow",
		"Stardrop",
		"Moonmunch",
		"Nebulord",
		"Quasar Kid",
		"Galaxy Gobbler",
	}

	-- tier -> id -> definition, for signatures, the pool, bodies and props.
	local function vocab(tier)
		local st = Style[tier]
		local v = { signatures = {}, pool = {}, bodies = {}, props = {} }
		for _, f in st.signatures do
			v.signatures[f.id] = f
		end
		for _, f in st.features do
			v.pool[f.id] = f
		end
		for _, b in st.bodies do
			v.bodies[b.id] = b
		end
		for _, p in st.props do
			v.props[p.id] = p
		end
		return v
	end

	local function generated()
		local out = {}
		for id, e in Mutants.species do
			if e.features then
				out[id] = e
			end
		end
		return out
	end

	-- MutantModel loaded with Lune's Roblox library (Instance, CFrame, ...).
	local function modelBuilder()
		local load = harness.loader({
			Instance = roblox.Instance,
			Vector3 = roblox.Vector3,
			Vector2 = roblox.Vector2,
			CFrame = roblox.CFrame,
			Color3 = roblox.Color3,
			Enum = roblox.Enum,
			ColorSequence = roblox.ColorSequence,
			NumberSequence = roblox.NumberSequence,
			NumberSequenceKeypoint = roblox.NumberSequenceKeypoint,
			NumberRange = roblox.NumberRange,
			typeof = roblox.typeof or typeof,
		})
		return load("src/shared/MutantModel")
	end

	return {
		["500 generated species, 83 per tier (26 / 20 / 16 / 13 / 8, +1 Common for Starter and Swamp)"] = function()
			local n = 0
			for _ in generated() do
				n += 1
			end
			t.eq(n, 500)
			for _, tier in Style.order do
				for rarity, count in COUNTS do
					local want = count + (if rarity == "Common" then EXTRA[tier] or 0 else 0)
					t.eq(#Mutants.buckets[tier][rarity], want, tier .. " " .. rarity)
				end
			end
		end,

		["limited eggs keep their hand-made species; the Almanac counts them all"] = function()
			for _, id in Eggs.limitedOrder do
				for _, rarity in { "Common", "Uncommon", "Rare", "Epic", "Legendary" } do
					local bucket = Mutants.buckets[id][rarity]
					t.ok(bucket and #bucket == 2, id .. " " .. rarity)
					for _, sid in bucket do
						t.ok(Mutants.species[sid].features == nil, sid .. " keeps the older traits")
					end
				end
			end
			local total = 0
			for _ in Mutants.species do
				total += 1
			end
			t.eq(total, 510)
			-- Milestones run every 25 up to 500, the last paying 100 Gems.
			t.eq(GameConfig.almanacMilestones.big[500].gems, 100)
		end,

		["feature budget: Common 1 .. Legendary 5, the signature first, one feature per slot"] = function()
			for id, e in generated() do
				local v = vocab(e.tier)
				local budget = Style.budget[e.rarity]
				t.eq(#e.features, budget.features, id .. " feature count")
				t.ok(v.signatures[e.features[1]], id .. " starts with a signature")
				local slots = { [v.signatures[e.features[1]].slot] = true }
				for i = 2, #e.features do
					local f = v.pool[e.features[i]]
					t.ok(f, id .. ": " .. e.features[i] .. " is from its tier's pool")
					t.ok(not slots[f.slot], id .. ": two features in slot " .. f.slot)
					slots[f.slot] = true
				end
				t.ok(v.bodies[e.body], id .. ": body " .. e.body .. " is its tier's")
			end
		end,

		["Epic and Legendary props unique within their tier; Legendary dances and is 1.2x"] = function()
			local seen = {}
			for id, e in generated() do
				local budget = Style.budget[e.rarity]
				if budget.prop then
					t.ok(e.prop and vocab(e.tier).props[e.prop], id .. " has its tier's prop")
					local key = e.tier .. "/" .. e.prop
					t.ok(not seen[key], id .. " shares prop " .. e.prop .. " with " .. tostring(seen[key]))
					seen[key] = id
				else
					t.eq(e.prop, nil, id .. " has no prop")
				end
				if e.rarity == "Legendary" then
					t.ok(table.find(Style[e.tier].idleVariants, e.idleVariant), id .. " dances a named variant")
					t.ok(e.scale >= 0.9 * 1.2 - 0.01, id .. " is 1.2x")
				else
					t.eq(e.idleVariant, nil)
					t.ok(e.scale <= 1.15 + 0.01, id .. " base scale")
				end
			end
		end,

		["no body, feature, prop or name syllable is shared between tiers"] = function()
			local owner = {}
			local function claim(kind, id, tier)
				local key = kind .. ":" .. id:lower()
				t.ok(
					owner[key] == nil or owner[key] == tier,
					string.format("%s %s in %s and %s", kind, id, tostring(owner[key]), tier)
				)
				owner[key] = tier
			end
			for _, tier in Style.order do
				local st = Style[tier]
				for _, b in st.bodies do
					claim("body", b.id, tier)
				end
				for _, list in { st.signatures, st.features } do
					for _, f in list do
						claim("feature", f.id, tier)
					end
				end
				for _, p in st.props do
					claim("prop", p.id, tier)
				end
				for _, key in { "first", "second", "words" } do
					for _, w in st.names[key] or {} do
						claim("syllable", w, tier)
					end
				end
				claim("syllable", st.names.title, tier)
			end
		end,

		["names: 510 unique, the 30 originals kept, Epic / Legendary affixes, nothing rude"] = function()
			local seen = {}
			for id, e in Mutants.species do
				local key = e.name:lower()
				t.ok(not seen[key], "duplicate name " .. e.name .. " (" .. id .. ", " .. tostring(seen[key]) .. ")")
				seen[key] = id
			end
			for _, name in ORIGINALS do
				t.ok(seen[name:lower()], "original " .. name .. " kept")
			end
			for id, e in generated() do
				if not table.find(ORIGINALS, e.name) then
					if e.rarity == "Epic" then
						local suffix = e.name:match(" (%a+)$")
						t.ok(table.find(Style.epicSuffixes, suffix), id .. " " .. e.name)
					elseif e.rarity == "Legendary" then
						t.ok(
							e.name:sub(1, #Style[e.tier].names.title + 1) == Style[e.tier].names.title .. " ",
							id .. " " .. e.name
						)
					end
				end
				-- Generated names pass the generator's filter (the hand-picked originals are exempt:
				-- "Toxic Titan").
				if not table.find(ORIGINALS, e.name) then
					local lower = e.name:lower():gsub("[^a-z]", "")
					for _, bad in { "fuk", "shit", "ass", "tit", "sex", "kill", "die", "poo" } do
						t.ok(not lower:find(bad, 1, true), id .. " " .. e.name)
					end
				end
			end
		end,

		["descriptions match the model: body and every feature's text"] = function()
			for id, e in generated() do
				local v = vocab(e.tier)
				t.ok(e.description:find(v.bodies[e.body].text, 1, true), id .. " body text")
				for _, f in e.features do
					local def = v.signatures[f] or v.pool[f]
					t.ok(e.description:find(def.text, 1, true), id .. " text for " .. f)
				end
				t.ok(e.funFact:find(e.name, 1, true), id .. " fun fact names it")
			end
		end,

		["every species builds at size 1 and Titan; Neon only on small details"] = function()
			local M = modelBuilder()
			for id, e in Mutants.species do
				for _, size in { 1, 3 } do
					local data = { tier = e.tier, rarity = e.rarity, species = id, mutations = {}, size = size }
					local ok, model = pcall(M.build, data)
					t.ok(ok, id .. " builds at size " .. size .. ": " .. tostring(model))
					local s = M.visualScale(data)
					t.ok(model.PrimaryPart ~= nil, id .. " has a root")
					t.ok((model:GetAttribute("Height") or 0) > 0, id .. " has a height")
					for _, d in model:GetDescendants() do
						if d:IsA("BasePart") and d.Material == roblox.Enum.Material.Neon then
							local big = math.max(d.Size.X, d.Size.Y, d.Size.Z)
							t.ok(
								big <= 0.5 * s + 1e-6,
								string.format("%s: Neon %s is %.2f studs (scale %.2f)", id, d.Name, big, s)
							)
						end
					end
				end
			end
		end,

		["idle poses: each tier's animation moves, still species stay put"] = function()
			local M = modelBuilder()
			for _, tier in Style.order do
				local moved = false
				for _, time in { 0.05, 0.3, 1.1, 2.7, 5.2 } do -- 0.05: inside a Lab twitch
					local pose = M.idlePose(tier, nil, time, 1)
					if pose.Position.Magnitude > 1e-4 or math.abs(pose.LookVector.Z + 1) > 1e-4 then
						moved = true
					end
				end
				t.ok(moved, tier .. " idle moves")
			end
			t.ok(M.idlePose("Pumpkin", nil, 1, 1) == roblox.CFrame.identity, "limited species don't use tier idles")
		end,
	}
end
