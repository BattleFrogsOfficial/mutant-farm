{
  "name": "MutantFarm",
  "tree": {
    "$className": "DataModel",
    "Workspace": {
      "$properties": { "StreamingEnabled": false }
    },
    "ReplicatedStorage": {
      "Shared": { "$path": "src/shared" },
      "Packages": { "$path": "Packages" }
